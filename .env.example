# Copy to .env.local and fill in from Supabase → Project Settings → API (or Data API / API Keys).
# Both values are public by design (they ship to the browser); never put the service_role /
# secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: Microsoft Clarity project ID (Clarity → Settings → Overview). Public.
VITE_CLARITY_PROJECT_ID=

# Optional: Google OAuth Web client ID (Google Cloud → Google Auth Platform → Clients), the same
# one entered in Supabase → Authentication → Providers → Google. Public. When set, Google's
# consent screen names this site instead of the Supabase project address.
VITE_GOOGLE_CLIENT_ID=
